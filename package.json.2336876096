{
  "name": "nexivo-ai-backend",
  "version": "0.0.1",
  "description": "Nexivo AI - AI Agency SaaS Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup --skipNodeModulesBundle",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "reset": "prisma migrate reset",
    "db:setup": "prisma generate && prisma migrate dev && npm run seed",
    "start": "node dist/server.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.11.0",
    "prisma": "^7.9.1",
    "tsx": "^4.7.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.7.0",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.2.0",
    "google-auth-library": "^9.7.0",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "ms": "^2.1.3",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "pg": "^8.11.3",
    "resend": "^3.2.0",
    "slugify": "^1.6.9",
    "stripe": "^14.20.0",
    "tsup": "^8.0.2",
    "zod": "^3.22.4"
  }
}